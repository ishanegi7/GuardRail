# GuardRail AI Environment Variables

# API Configuration
PORT=8000
DATABASE_URL=sqlite:///./data/guardrail.db

# LLM Configuration (Set one depending on LLM_PROVIDER)
LLM_PROVIDER=gemini # 'gemini', 'openai', or 'anthropic'
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Demo API Configuration
DEMO_API_URL=http://demo-api:8080
